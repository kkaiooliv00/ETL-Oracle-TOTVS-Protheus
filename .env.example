# Oracle TOTVS Protheus (somente leitura)
ORA_HOST=
ORA_PORT=
ORA_SERVICE=
ORA_USER=
ORA_PASSWORD=

# PostgreSQL destino (Supabase)
DATABASE_URL=postgresql://postgres:senha@db.xxx.supabase.co:6543/postgres

# PostgreSQL de origem para cargas no schema gw (somente leitura)
GW_SOURCE_HOST=rds-los-12-leitura-bi-revolux.cbqxjhiaugyj.us-east-2.rds.amazonaws.com
GW_SOURCE_PORT=5432
GW_SOURCE_DATABASE=postgres
GW_SOURCE_USER=bi_machine
GW_SOURCE_PASSWORD=
# Opcional; padrao: require
GW_SOURCE_SSLMODE=require

# Supabase destino exclusivo da carga gw (opcional; sem ele, usa DATABASE_URL)
GW_DATABASE_URL=postgresql://postgres:senha@db.xxx.supabase.co:6543/postgres

# Arquivo de configuracao de jobs (opcional — padrao: oracle_jobs.yml)
ETL_JOBS_FILE=oracle_jobs.yml

# Tamanho dos lotes (opcional; reduza se o runner tiver pouca memoria)
ORACLE_FETCH_SIZE=20000
STAGING_FLUSH_RECORDS=20000
POSTGRES_FETCH_SIZE=20000
